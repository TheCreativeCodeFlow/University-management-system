{
    "manifest_version": 2,
  
    "name": "Note Taking Web Extension",
    "description": "Cause who has the time to open notes app",
    "version": "1.0",
  
    "browser_action": {
      "default_icon": "icon.png",
      "default_popup": "src/popup.html"
    },
  
    "permissions": [
      "activeTab",
      "tabs"
    ],
  
    "content_scripts": [
      {
        "matches": ["http://*/*", "https://*/*"],
        "js": ["src/build/main.js"]
      }
    ]
  }